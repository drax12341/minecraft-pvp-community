    "bot": "node --env-file=.env discord/bot.mjs"
  },
  "dependencies": {
    "discord.js": "^14.24.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10"
  }
}
