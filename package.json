{
  "name": "minecraft-pvp-community",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "discord:plan": "node discord/setup.mjs",
    "discord:apply": "node --env-file=.env discord/setup.mjs --apply",
    "discord:upgrade": "node --env-file=.env discord/upgrade.mjs",
    "discord:upgrade:apply": "node --env-file=.env discord/upgrade.mjs --apply",
    "discord:register": "node --env-file=.env discord/bot.mjs --register-only",
    "bot": "node --env-file=.env discord/bot.mjs",
    "start:community": "node --env-file-if-exists=.env server/runtime.mjs"
  },
  "dependencies": {
    "discord.js": "^14.24.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10"
  }
}
